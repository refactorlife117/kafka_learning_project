NODE_ENV=development
PORT=3002
LOG_LEVEL=info

# PostgreSQL database owned ONLY by this service
# e.g. postgresql://user:password@localhost:5432/fitness_classes
DATABASE_URL=
DB_MIGRATE_ON_START=true

KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=class-service
KAFKA_GROUP_ID=class-service
KAFKA_REPLICATION_FACTOR=1
OUTBOX_POLL_INTERVAL_MS=1000
