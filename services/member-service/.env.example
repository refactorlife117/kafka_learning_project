NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# PostgreSQL database owned ONLY by this service
# e.g. postgresql://user:password@localhost:5432/fitness_members
# (append ?sslmode=require for hosted databases like Neon/Supabase)
DATABASE_URL=
DB_MIGRATE_ON_START=true

# Must be the same value as in api-gateway/.env (gateway verifies tokens this service signs)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=member-service
KAFKA_REPLICATION_FACTOR=1
OUTBOX_POLL_INTERVAL_MS=1000
