NODE_ENV=development
PORT=3003
LOG_LEVEL=info

# PostgreSQL database owned ONLY by this service
# e.g. postgresql://user:password@localhost:5432/fitness_bookings
DATABASE_URL=
DB_MIGRATE_ON_START=true

KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=booking-service
KAFKA_GROUP_ID=booking-service
KAFKA_REPLICATION_FACTOR=1
OUTBOX_POLL_INTERVAL_MS=1000
